# AgriTech Backend — Environment Variables
# Copy this file to .env and fill in your values

# Weather API (OpenWeatherMap free tier — get key at openweathermap.org)
WEATHER_API_KEY=your_openweathermap_api_key_here
WEATHER_DEFAULT_CITY=Ludhiana
WEATHER_DEFAULT_COUNTRY=IN

# App
APP_ENV=development
SECRET_KEY=agritech-sih-secret-key-change-in-production

# Database (SQLite for hackathon; swap to postgresql+asyncpg://... for production)
DATABASE_URL=sqlite:///./agritech.db

# CORS — comma-separated origins allowed
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
